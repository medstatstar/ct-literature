# ── 发布包剔除项（§16.8；与 .gitignore 双平台对齐）────────────────
# 测试 / 缓存 / 中间产物不进包
tests/
__pycache__/
*.pyc
*.pyo
*.db
out/
*.log
.Rhistory
.RData
staging/

# 本地凭据不进包（README 承诺：仅 .env.example 随包发布；用户自行配置 key）
.env

# 用户自定义检索词扩展（README 承诺 git-ignored，随包公开会泄漏用户词库）
references/user_terms.json

# coze 工作流代码包镜像（私有端点源码，§16.7 双平台排除）
adapters/coze/

# ── Full-text guideline documents are the author's curated IP and MUST NOT ship with
# this skill. The builder writes them to an EXTERNAL cache by default
# (~/.workbuddy/ct-guideline-docs), never under references/guidelines/. These lines are
# defense-in-depth in case someone overrides --doc-cache-dir to live inside the skill tree.
# The pointer index (guidelines_index.json) is intentionally NOT ignored — it is the skill's data.
references/guidelines/docs/
references/guidelines/**/*.pdf
references/guidelines/**/*.xml
references/guidelines/**/*.html
ct-guideline-docs/
